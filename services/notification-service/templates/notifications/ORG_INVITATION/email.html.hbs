<!DOCTYPE html>
<html>
  <body style="font-family: system-ui, sans-serif; line-height: 1.5; color: #111">
    <p>Hello {{inviteeName}},</p>
    <p>
      <strong>{{inviterName}}</strong> invited you to join <strong>{{organizationName}}</strong>
      on <strong>{{appName}}</strong> as a member.
    </p>
    <p><a href="{{invitationUrl}}" style="display: inline-block; padding: 10px 18px; background: #0b57d0; color: #fff; border-radius: 6px; text-decoration: none">View the invitation</a></p>
    <p style="font-size: 0.875rem; color: #444">{{invitationUrl}}</p>
    <p style="font-size: 0.875rem; color: #666">
      You only join if you accept. The link stays valid for {{expiresInDays}} days.
    </p>
  </body>
</html>
