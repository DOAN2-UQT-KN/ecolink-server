# Suggested local ports: identity 4000 | incident 3001 | reward 3002 | notification 3003 | api-gateway 8081

PORT=3003
NODE_ENV=development
DATABASE_URL="postgresql://postgres:password@localhost:5432/notificationdb?schema=public"

# Must match identity-service/.env — same JWT_SECRET (Bearer on /my, /:id/read) and INTERNAL_IDENTITY_API_KEY.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

IDENTITY_SERVICE_URL=http://localhost:4000
INTERNAL_IDENTITY_API_KEY=change-me-internal-only

# Required for POST /api/v1/notifications/jobs from other services
INTERNAL_NOTIFICATION_API_KEY=change-me-internal-only

# SQS (same pattern as incident-service report analysis)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack example: http://localhost:4566/000000000000/notification-send
SQS_NOTIFICATION_QUEUE_URL=http://localhost:4566/000000000000/notification-send

# Optional: for LocalStack / custom endpoint
# AWS_SQS_ENDPOINT=http://localhost:4566

# Worker tuning (optional)
# WORKER_SQS_WAIT_TIME_SECONDS=20
# WORKER_SQS_VISIBILITY_TIMEOUT_SECONDS=120
# WORKER_BATCH_SIZE=5
# WORKER_MAX_RECEIVE_COUNT=5
# WORKER_RETRY_BASE_SECONDS=30
# WORKER_MAX_RETRY_DELAY_SECONDS=900

# ---------------------------------------------------------------------------
# SMTP
#
# Leave SMTP_HOST empty and nothing is actually sent: the notification row is still
# written (so the OTP / link is readable from the `notifications` table) and the
# provider logs `smtp_not_configured`. Fine for local work, useless for a demo.
#
# The transporter is built once and cached, so changing any of these needs a restart.
#
#   SMTP_SECURE=true  -> implicit TLS, use port 465
#   SMTP_SECURE=false -> STARTTLS, use port 587
#   SMTP_FROM         -> falls back to SMTP_USER, then noreply@localhost
#
# Gmail (needs 2FA on, then an App Password — the normal password will not work):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password, no spaces>
#   SMTP_FROM=EcoLink <you@gmail.com>
#
# Mailtrap / Mailpit — a sandbox inbox that catches everything, better for dev
# because no real mail leaves the machine:
#   SMTP_HOST=sandbox.smtp.mailtrap.io   (Mailpit: localhost)
#   SMTP_PORT=2525                       (Mailpit: 1025)
#   SMTP_SECURE=false
#   SMTP_USER=<from the Mailtrap inbox>  (Mailpit: leave empty)
#   SMTP_PASS=<from the Mailtrap inbox>  (Mailpit: leave empty)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nngtkhngoc@g
SMTP_PASS=
SMTP_FROM=

CORS_ORIGIN=*
SWAGGER_SERVER_URL=http://localhost:3003
