# Identity Service Configuration
#
# Suggested local ports (each service on its own port):
#   identity 4000 | incident 3001 | reward 3002 | notification 3003 | api-gateway 8081

# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@ecolink.id.vn:5433/identitydb?schema=public"

# Server-to-server (e.g. notification-service GET /internal/v1/users/:id/email)
INTERNAL_IDENTITY_API_KEY=change-me-internal-only

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

# Optional: organization contact-email verification tokens (incident-service). Default 72h.
# ORG_CONTACT_EMAIL_TOKEN_TTL_MS=

# Lifetime of the link that lets a provisioned organization account set its first
# password (POST /api/v1/auth/activate-org-account). Defaults to 72h.
# ORG_ACCOUNT_ACTIVATION_TTL_MS=

# CORS
CORS_ORIGIN=*

# Datadog (local dev). When DD_API_KEY is set, app logs are shipped to Datadog over
# HTTPS (the in-container Agent cannot read host stdout). Leave unset in Kubernetes,
# where the Agent collects container stdout instead.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=identity-service
DD_ENV=local
