DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecolink
JWT_SECRET=
# Shared with incident-service for /internal/v1 (translation + duplicate write-back)
INTERNAL_AI_API_KEY=
CORS_ORIGIN=*
INCIDENT_API_BASE_URL=http://localhost:3001
AUTO_CREATE_DB_TABLES=true

# SQS consumer for REPORT_SUBMITTED (must match incident-service outbox route).
# LocalStack queue is created as `ai-analysis-job`.
SQS_AI_ANALYSIS_QUEUE_URL=http://localhost:4566/000000000000/ai-analysis-job
AWS_REGION=us-east-1
AWS_SQS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Google Cloud Vision API key (restricted to the Vision API) for the duplicate signal `internet`; empty = signal NOT_AVAILABLE
GOOGLE_VISION_API_KEY=
