generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Configurable campaign difficulty tier: volunteer cap and green-point reward.
/// Referenced by `campaigns.difficulty` (level) in incident-service.
model Difficulty {
  id String @id @default(uuid()) @db.Uuid

  /// Unique tier index (1 = easy … 4 = very hard).
  level Int @unique

  name   String  @db.VarChar(64)
  nameVi String? @map("name_vi") @db.VarChar(64)
  nameEn String? @map("name_en") @db.VarChar(64)

  /// Maximum approved volunteers; null means no limit (very hard).
  maxVolunteers Int? @map("max_volunteers")

  /// Suggested minimum volunteers per campaign day; lower needs a reason from the creator.
  suggestedMinVolunteers Int? @map("suggested_min_volunteers")

  greenPoints Int @map("green_points")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("difficulties")
}

/// Per-user running balance of green points (reward-service is source of truth).
model UserGreenPointBalance {
  userId String @id @map("user_id") @db.Uuid

  balance Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_green_point_balances")
}

/// The only green-point ledger: every credit and debit (earnings, redeem, refund, expiry, migration adjust).
/// Idempotency: unique (user_id, idempotency_key); write via insertLedgerOnce (ON CONFLICT DO NOTHING).
model GreenPointTransaction {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// e.g. CAMPAIGN_COMPLETION, UPVOTE, REFERRAL
  type String @db.VarChar(64)

  /// Related entity id (campaign UUID, report UUID, etc.)
  resourceId String @map("resource_id") @db.Uuid

  /// What resource_id denotes: CAMPAIGN, REPORT, USER, …
  resourceType String @map("resource_type") @db.VarChar(64)

  points Int

  /// Snapshot context (rule ids, thresholds, etc.) for audit/debug; never used to recompute points.
  metadata Json?

  /// Stable per-user key, e.g. campaign_completion:<id>, vote_milestone:<reportId>:<n>, expire:<lotId>.
  idempotencyKey String @map("idempotency_key") @db.VarChar(256)

  lot GreenPointLot?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([type])
  @@map("green_point_transactions")
}

model Media {
  id   String @id @default(uuid()) @db.Uuid
  url  String
  type String @db.VarChar(50)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  gifts       Gift[]
  giftSources GiftSource[]

  @@index([type])
  @@index([deletedAt])
  @@map("media")
}

/// Catalog item users can redeem for green points.
model Gift {
  id String @id @default(uuid()) @db.Uuid

  name   String  @db.VarChar(255)
  nameVi String? @map("name_vi") @db.VarChar(255)
  nameEn String? @map("name_en") @db.VarChar(255)

  mediaId String? @map("media_id") @db.Uuid

  description   String  @db.Text
  descriptionVi String? @map("description_vi") @db.Text
  descriptionEn String? @map("description_en") @db.Text

  /// Green points required to redeem once.
  greenPoints Int @map("green_points")

  /// Cache of the live batches' remaining (spec 015 R2); updated with every stock movement.
  stockRemaining Int @default(0) @map("stock_remaining")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  redemptions GiftRedemption[]
  batches     GiftStockBatch[]
  movements   GiftStockMovement[]
  media       Media?              @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([deletedAt])
  @@index([isActive])
  @@index([mediaId])
  @@map("gifts")
}

model GiftRedemption {
  id String @id @default(uuid()) @db.Uuid

  /// Public order code "EL-" + 8 chars (no 0 O 1 I L), set at creation and never changed (spec 017).
  code String @unique @db.VarChar(11)

  userId String @map("user_id") @db.Uuid

  giftId String @map("gift_id") @db.Uuid

  /// Total points paid = unitPoints * quantity (DB CHECK).
  greenPointsSpent Int @map("green_points_spent")

  /// Items of the gift in this order, 1..10 (spec 018); the upper bound is a service rule.
  quantity   Int @default(1)
  /// Listed price of one item when ordered.
  unitPoints Int @map("unit_points")

  phoneNumber String @map("phone_number") @db.VarChar(32)

  /// Delivery address as picked on the map (Goong place or reverse-geocoded pin).
  pickupLocation String @map("pickup_location") @db.Text

  /// Delivery details; required for new orders, null on orders made before they were asked for.
  recipientName     String? @map("recipient_name") @db.VarChar(100)
  /// House number, building, floor, room — what the map address does not carry.
  addressDetail     String? @map("address_detail") @db.VarChar(255)
  deliveryLatitude  Float?  @map("delivery_latitude")
  deliveryLongitude Float?  @map("delivery_longitude")
  deliveryNote      String? @map("delivery_note") @db.VarChar(500)

  status GiftRedemptionStatus @default(PROCESSING)

  statusUpdatedAt DateTime @default(now()) @map("status_updated_at")

  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// Deprecated (spec 018): not written for new orders; read the REDEEM_OUT movements instead.
  batchId String? @map("batch_id") @db.Uuid

  /// Required when cancelled from spec 016 on; null for older cancellations.
  cancelReason String? @map("cancel_reason") @db.VarChar(500)

  /// Whether the item went back to its batch on cancel; null unless cancelled.
  restocked Boolean?

  /// Third-party carrier and its tracking code; required when the order is shipped (spec 017).
  carrier      String?   @db.VarChar(100)
  trackingCode String?   @map("tracking_code") @db.VarChar(100)
  shippedAt    DateTime? @map("shipped_at")

  gift  Gift            @relation(fields: [giftId], references: [id], onDelete: Restrict)
  batch GiftStockBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  lotSpends      GreenPointLotSpend[]
  stockMovements GiftStockMovement[]
  events         GiftRedemptionEvent[]

  @@index([userId])
  @@index([giftId])
  @@index([batchId])
  @@index([status, createdAt])
  @@map("gift_redemptions")
}

enum GiftRedemptionStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum GiftRedemptionEventType {
  CREATED
  SHIPPED
  TRACKING_UPDATED
  DELIVERED
  CANCELLED
}

enum GiftRedemptionActorRole {
  USER
  ADMIN
}

/// Append-only order history (spec 017); rows are never updated or deleted.
model GiftRedemptionEvent {
  id String @id @default(uuid()) @db.Uuid

  redemptionId String @map("redemption_id") @db.Uuid

  type GiftRedemptionEventType

  fromStatus GiftRedemptionStatus? @map("from_status")
  toStatus   GiftRedemptionStatus? @map("to_status")

  actorRole GiftRedemptionActorRole @map("actor_role")
  /// Null on rows rebuilt for orders made before spec 017.
  actorId   String?                 @map("actor_id") @db.Uuid

  /// carrier / trackingCode / previous* / cancelReason / restocked, by type.
  data Json?

  /// Rebuilt from timestamps for orders made before spec 017.
  reconstructed Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  redemption GiftRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)

  @@index([redemptionId, createdAt])
  @@map("gift_redemption_events")
}

/// Outbox + tracking for reward-service background jobs (e.g. green-point SQS worker, @da2/queue).
model RewardBackgroundJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType     String    @map("job_type") @db.VarChar(100)
  payload     Json
  status      Int       @default(12)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([jobType, status])
  @@index([status])
  @@map("reward_background_jobs")
}

// --- Gamification v2: seasonal RP (CRP/VRP), persistent SP wallet batches, badges, snapshots ---

enum SeasonKind {
  MONTHLY
  QUARTERLY
}

/// Ranking / spendable kinds stored on the unified ledger.
enum PointKind {
  CRP
  VRP
  SP
}

enum PointSourceType {
  REPORT
  CAMPAIGN
  SYSTEM
  STORE
  SEASON_END
}

enum LeaderboardSubjectKind {
  USER
  ORGANIZATION
}

enum LeaderboardMetric {
  CRP
  VRP
  REPORT_UPVOTES
  REPORT_COUNT
  CAMPAIGN_COMPLETED
  /// Legacy org leaderboard metric (kept for backward compatibility).
  ORG_AGGREGATE
}

enum BadgeScope {
  LIFETIME
  SEASON
}

/// Badge grouping for deterministic metric compatibility.
enum BadgeCategory {
  REPORT
  CAMPAIGN
  CONTRIBUTION
  RANK
}

/// Time-bounded competitive window for RP, badges, and leaderboard snapshots.
model Season {
  id     String     @id @default(uuid()) @db.Uuid
  label  String?    @db.VarChar(128)
  kind   SeasonKind @map("season_kind")
  status Int        @default(1)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRpTotals         UserSeasonRpTotal[]
  organizationScores   OrganizationSeasonScore[]
  leaderboardRows      LeaderboardSnapshot[]
  badgeGrants          UserBadgeGrant[]
  reportMilestones     ReportMilestoneAward[]
  campaignRewardAwards CampaignRewardAward[]
  payoutTiers          SeasonLeaderboardPayoutTier[]
  userPointTxSeason    UserPointTransaction[]        @relation("SeasonUserPointTransactions")

  @@index([status])
  @@index([startsAt, endsAt])
  @@map("seasons")
}

/// Green-point lots (formerly user_sp_wallet). Balance = SUM(remaining) of lots with expires_at > now.
/// CHECK (remaining >= 0 AND remaining <= amount); partial index (user_id, expires_at) WHERE remaining > 0 lives in SQL.
model GreenPointLot {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Ledger row that created the lot; null for lots carried over from the SP wallet.
  transactionId String?                @unique @map("transaction_id") @db.Uuid
  transaction   GreenPointTransaction? @relation(fields: [transactionId], references: [id])

  amount    Int
  remaining Int

  /// Legacy SP source; null for lots created after step 2. Dropped in cleanup.
  sourceType PointSourceType? @map("source_type")
  sourceId   String?          @map("source_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  spends GreenPointLotSpend[]

  @@index([expiresAt])
  @@map("green_point_lots")
}

/// How much a redemption took from each lot, so a cancel can give it back to the same lots.
model GreenPointLotSpend {
  id String @id @default(uuid()) @db.Uuid

  redemptionId String         @map("redemption_id") @db.Uuid
  redemption   GiftRedemption @relation(fields: [redemptionId], references: [id])

  lotId String        @map("lot_id") @db.Uuid
  lot   GreenPointLot @relation(fields: [lotId], references: [id])

  amount Int

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([redemptionId, lotId])
  @@index([redemptionId])
  @@map("green_point_lot_spends")
}

/// Unified ledger: all CRP/VRP/SP movements (credits and debits). RP rows MUST set `seasonId`.
model UserPointTransaction {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  kind   PointKind
  amount Int

  sourceType PointSourceType @map("source_type")
  sourceId   String?         @map("source_id") @db.Uuid

  seasonId String? @map("season_id") @db.Uuid

  metadata Json?

  /// Worker-generated stable key for exactly-once credits/debits (partial unique index in SQL migration).
  idempotencyKey String? @map("idempotency_key") @db.VarChar(256)

  createdAt DateTime @default(now()) @map("created_at")

  season Season? @relation("SeasonUserPointTransactions", fields: [seasonId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, kind])
  @@index([seasonId])
  @@index([sourceType, sourceId])
  @@map("user_point_transactions")
}

/// Materialized seasonal RP totals for fast leaderboard reads (updated after each RP ledger append).
model UserSeasonRpTotal {
  userId   String @map("user_id") @db.Uuid
  seasonId String @map("season_id") @db.Uuid

  citizenRp   Int @default(0) @map("citizen_rp")
  volunteerRp Int @default(0) @map("volunteer_rp")

  updatedAt DateTime @updatedAt @map("updated_at")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([userId, seasonId])
  @@index([seasonId, citizenRp(sort: Desc)])
  @@index([seasonId, volunteerRp(sort: Desc)])
  @@map("user_season_rp_totals")
}

/// Org aggregate for seasonal volunteer footprint (ingested from domain events; computation owned by workers).
model OrganizationSeasonScore {
  organizationId String @map("organization_id") @db.Uuid
  seasonId       String @map("season_id") @db.Uuid

  aggregateScore Int @default(0) @map("aggregate_score")

  updatedAt DateTime @updatedAt @map("updated_at")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([organizationId, seasonId])
  @@index([seasonId, aggregateScore(sort: Desc)])
  @@map("organization_season_scores")
}

/// Idempotency: one CRP milestone payout per report/user/season/threshold.
model ReportMilestoneAward {
  id String @id @default(uuid()) @db.Uuid

  reportId String @map("report_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  seasonId String @map("season_id") @db.Uuid

  milestoneThreshold Int @map("milestone_threshold")

  ledgerTxId String? @map("ledger_tx_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId, seasonId, milestoneThreshold])
  @@index([userId])
  @@map("report_milestone_awards")
}

/// Idempotency for volunteer completion + optional campaign upvote milestone payouts.
model CampaignRewardAward {
  id String @id @default(uuid()) @db.Uuid

  campaignId String @map("campaign_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  seasonId   String @map("season_id") @db.Uuid

  /// COMPLETION_BASE | UPVOTE_MILESTONE:<n> — encoded string for uniqueness.
  awardKey String @map("award_key") @db.VarChar(128)

  ledgerTxId String? @map("ledger_tx_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, seasonId, awardKey])
  @@index([userId])
  @@map("campaign_reward_awards")
}

/// Singleton-style rows (fixed ids) or versioned via `effective_from` — workers read latest active.
model GamificationPointRules {
  id String @id @default(uuid()) @db.Uuid

  /// Per-milestone citizen multiplier index (1 for first threshold crossed, 2 for second, …).
  baseReportPoint Int @map("base_report_point")

  /// Sorted ascending in application layer (e.g. [10, 20, 50, 100]).
  reportMilestoneThresholds Int[] @default([]) @map("report_milestone_thresholds")

  /// Points for a campaign completion at full participation (scaled by eligible / registered shifts).
  campaignCompletionPoints Int @default(20) @map("campaign_completion_points")

  /// Points for a report the admin marks done.
  reportCompletionPoints Int @default(0) @map("report_completion_points")

  /// Days until a newly created green-point lot expires.
  pointExpirationDays Int @default(90) @map("point_expiration_days")

  history GamificationPointRuleHistory[]

  isActive Boolean @default(true) @map("is_active")

  effectiveFrom DateTime @default(now()) @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive, effectiveFrom(sort: Desc)])
  @@map("gamification_point_rules")
}

/// One row per admin save of the point rules (insert only).
model GamificationPointRuleHistory {
  id String @id @default(uuid()) @db.Uuid

  ruleId String                 @map("rule_id") @db.Uuid
  rule   GamificationPointRules @relation(fields: [ruleId], references: [id])

  changedBy String @map("changed_by") @db.Uuid

  before Json?
  after  Json

  changedAt DateTime @default(now()) @map("changed_at")

  @@index([ruleId, changedAt(sort: Desc)])
  @@map("gamification_point_rule_history")
}

/// Org relationship multipliers for VRP (no stacking — worker picks highest applicable).
model VolunteerOrgMultiplierRule {
  id String @id @default(uuid()) @db.Uuid

  /// Stable code: MEMBER_OF_OWNER_ORG | PARTICIPANT_OTHER_ORG_CAMPAIGN | DEFAULT
  code       String  @unique @db.VarChar(64)
  multiplier Decimal @db.Decimal(4, 2)

  priority Int @default(0)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, priority(sort: Desc)])
  @@map("volunteer_org_multiplier_rules")
}

model SpendablePointRules {
  id String @id @default(uuid()) @db.Uuid

  expirationDays Int @default(90) @map("expiration_days")

  isActive Boolean @default(true) @map("is_active")

  effectiveFrom DateTime @default(now()) @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive, effectiveFrom(sort: Desc)])
  @@map("spendable_point_rules")
}

model SeasonScheduleRules {
  id String @id @default(uuid()) @db.Uuid

  kind SeasonKind @unique @map("season_kind")

  /// Cron or preset handled in worker; store human hint only if needed.
  autoRotate Boolean @default(true) @map("auto_rotate")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("season_schedule_rules")
}

/// SP payouts to leaderboard winners (applied at season freeze).
model SeasonLeaderboardPayoutTier {
  id String @id @default(uuid()) @db.Uuid

  seasonId String? @map("season_id") @db.Uuid

  metric LeaderboardMetric

  rankMin Int @map("rank_min")
  rankMax Int @map("rank_max")

  spAmount Int @map("sp_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  season Season? @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, metric])
  @@map("season_leaderboard_payout_tiers")
}

model BadgeDefinition {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique @db.VarChar(128)
  name String @db.VarChar(255)

  /// Display symbol or icon key (e.g. emoji, URL slug for asset).
  symbol String? @db.VarChar(128)

  category BadgeCategory

  scope BadgeScope @default(SEASON)

  /// When true, badge logic can grant multiple times per user (subject to caps).
  isRepeatable Boolean @default(false) @map("is_repeatable")

  /// Optional hard cap on total times a user may earn this badge.
  maxGrantsPerUser Int? @map("max_grants_per_user")

  /// Cooldown between repeat grants in seconds (0 = no cooldown).
  cooldownSeconds Int @default(0) @map("cooldown_seconds")

  /// JSON rules AST evaluated by the badge rules engine.
  rulesConfig Json? @map("rules_config")

  /// Benefits: discount bps, partner tier codes, etc.
  reward Json?

  isActive Boolean @default(true) @map("is_active")

  /// When set, badge is published; slug cannot change.
  publishedAt DateTime? @map("published_at")

  /// Denormalized: set when slug becomes immutable (publish or first grant).
  slugLockedAt DateTime? @map("slug_locked_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  grants UserBadgeGrant[]

  @@index([category, isActive])
  @@map("badge_definitions")
}

model UserBadgeGrant {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  badgeId String @map("badge_id") @db.Uuid

  seasonId String? @map("season_id") @db.Uuid

  grantedAt DateTime @default(now()) @map("granted_at")

  metadata Json?

  badge  BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  season Season?         @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([badgeId])
  @@index([seasonId])
  @@map("user_badge_grants")
}

model LeaderboardSnapshot {
  id String @id @default(uuid()) @db.Uuid

  seasonId String @map("season_id") @db.Uuid

  subjectKind LeaderboardSubjectKind @map("subject_kind")
  subjectId   String                 @map("subject_id") @db.Uuid

  metric LeaderboardMetric

  score Int
  rank  Int

  capturedAt DateTime @default(now()) @map("captured_at")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, subjectKind, subjectId, metric])
  @@index([seasonId, metric, rank])
  @@map("leaderboard_snapshots")
}

/// Logical metric sources for badge rule builder UI (keys align with rule `target` strings).
model MetricTable {
  id String @id @default(uuid()) @db.Uuid

  key String @unique @db.VarChar(64)

  label String @db.VarChar(255)

  description String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  columns MetricColumn[]

  @@map("metric_tables")
}

/// Selectable fields per metric table (aggregation/operators enforced in application layer, not stored).
model MetricColumn {
  id String @id @default(uuid()) @db.Uuid

  tableId String @map("table_id") @db.Uuid

  table MetricTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  key String @db.VarChar(64)

  label String @db.VarChar(255)

  /**
   * FE hint: `integer`, `number`, etc.
   */
  valueType String @map("value_type") @db.VarChar(32)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tableId, key])
  @@index([tableId])
  @@map("metric_columns")
}

enum GiftSourceType {
  SPONSOR
  ECOLINK
  DONATION
}

enum GiftSourceStatus {
  ACTIVE
  INACTIVE
}

enum GiftStockMovementType {
  STOCK_IN
  REDEEM_OUT
  CANCEL_RETURN
  ADJUST_OUT
  EXPIRED
}

enum GiftStockAdjustReason {
  DAMAGED
  LOST
  COUNT_SHORTAGE
  RETURN_TO_SOURCE
}

/// Where gifts come from (spec 015). Never hard-deleted; INACTIVE sources take no new batches.
model GiftSource {
  id String @id @default(uuid()) @db.Uuid

  name         String           @db.VarChar(255)
  type         GiftSourceType
  contactName  String?          @map("contact_name") @db.VarChar(255)
  contactPhone String?          @map("contact_phone") @db.VarChar(32)
  contactEmail String?          @map("contact_email") @db.VarChar(255)
  logoMediaId  String?          @map("logo_media_id") @db.Uuid
  showOnGift   Boolean          @default(false) @map("show_on_gift")
  status       GiftSourceStatus @default(ACTIVE)
  note         String?          @db.Text
  createdBy    String?          @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logo    Media?           @relation(fields: [logoMediaId], references: [id], onDelete: SetNull)
  batches GiftStockBatch[]

  @@index([status, type])
  @@index([name])
  @@map("gift_sources")
}

/// One receipt of a gift from a source. 0 <= remaining <= quantity (DB CHECK).
model GiftStockBatch {
  id String @id @default(uuid()) @db.Uuid

  giftId         String    @map("gift_id") @db.Uuid
  sourceId       String    @map("source_id") @db.Uuid
  quantity       Int
  remaining      Int
  unitValueVnd   Int       @map("unit_value_vnd")
  receivedAt     DateTime  @map("received_at")
  expiresAt      DateTime? @map("expires_at")
  /// Document number; may be empty when the proof is only in `attachmentUrls`.
  reference      String    @db.VarChar(255)
  /// Uploaded proof files (contract, sponsor letter, invoice, receipt), at most 5 URLs.
  attachmentUrls String[]  @default([]) @map("attachment_urls")
  note           String?   @db.Text
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  gift        Gift                @relation(fields: [giftId], references: [id], onDelete: Restrict)
  source      GiftSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  movements   GiftStockMovement[]
  redemptions GiftRedemption[]

  @@index([sourceId, receivedAt])
  @@map("gift_stock_batches")
}

/// Append-only stock history; per batch SUM(quantity) = remaining.
model GiftStockMovement {
  id String @id @default(uuid()) @db.Uuid

  giftId       String                 @map("gift_id") @db.Uuid
  batchId      String                 @map("batch_id") @db.Uuid
  type         GiftStockMovementType
  quantity     Int
  reason       GiftStockAdjustReason?
  note         String?                @db.Text
  redemptionId String?                @map("redemption_id") @db.Uuid
  actorId      String?                @map("actor_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at")

  gift       Gift            @relation(fields: [giftId], references: [id], onDelete: Restrict)
  batch      GiftStockBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  redemption GiftRedemption? @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  /// One REDEEM_OUT and one CANCEL_RETURN per order and batch (spec 018).
  @@unique([redemptionId, batchId, type])
  @@index([giftId, createdAt(sort: Desc)])
  @@index([batchId])
  @@map("gift_stock_movements")
}
