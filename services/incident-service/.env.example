# Copy to .env for local development
#
# Suggested local ports: identity 3000 | incident 3001 | reward 3002 | notification 3003 | api-gateway 8081

PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@ecolink.id.vn:5433/incidentdb?schema=public"

JWT_SECRET=local-dev-secret-key-12345
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=*

# AI service (internal route for translation; must match ai-service INTERNAL_AI_API_KEY)
AI_SERVICE_URL=http://localhost:3004
INTERNAL_AI_API_KEY=must-match-ai-service

# Identity service (opaque tokens for organization contact-email verification links)
# IDENTITY_SERVICE_URL=http://localhost:3000
# INTERNAL_IDENTITY_API_KEY=must-match-identity-service

# URL of this service as used in emails (verification link). Defaults to http://localhost:PORT
# PUBLIC_INCIDENT_API_URL=http://localhost:3001

# Frontend base URL for redirects after contact email verification
# FRONTEND_APP_URL=http://localhost:3000

# Display name in verification emails (notification templates)
# APP_NAME=DA2

# Reward service (read-only internal queries: difficulties/capacity; must match reward-service INTERNAL_REWARD_API_KEY)
REWARD_SERVICE_URL=http://localhost:3002
INTERNAL_REWARD_API_KEY=must-match-reward-service

# Enqueue contact verification email via notification-service (optional; logs warning if unset)
# NOTIFICATION_SERVICE_URL=http://localhost:3003
# INTERNAL_NOTIFICATION_API_KEY=must-match-notification-service

# Comma-separated identity user UUIDs notified when a manager submits a campaign for final completion (in-app / email via notification-service)
# CAMPAIGN_COMPLETION_ADMIN_NOTIFY_USER_IDS=

# SQS (LocalStack)
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_REPORT_ANALYSIS_QUEUE_URL=http://localhost:4566/000000000000/durable-background-job
SQS_INCIDENT_TRANSLATION_QUEUE_URL=http://localhost:4566/000000000000/incident-translation
# Shared reward intake queue the outbox relay publishes green-point / recognition
# events onto (must match reward-service SQS_REWARD_INTAKE_QUEUE_URL).
SQS_REWARD_INTAKE_QUEUE_URL=http://localhost:4566/000000000000/reward-intake
# Concurrency for the TRANSLATE_TEXT worker (defaults to 1).
# TRANSLATE_TEXT_CONCURRENCY=1

# Transactional outbox relay (runs in the worker process; publishes green-point /
# recognition events to the reward intake SQS queue). Set ENABLED=false to turn it off.
# OUTBOX_RELAY_ENABLED=true
# OUTBOX_RELAY_BATCH_SIZE=20
# OUTBOX_RELAY_POLL_INTERVAL_MS=2000
# OUTBOX_RELAY_RETRY_BASE_MS=30000
# OUTBOX_RELAY_MAX_RETRY_DELAY_MS=900000
#
# Circuit breaker on the outbox -> reward publish path. After N consecutive
# publish failures the relay stops claiming for OPEN_MS (events stay PENDING),
# then probes recovery with a single trial; SUCCESS_THRESHOLD trials close it.
# OUTBOX_BREAKER_FAILURE_THRESHOLD=5
# OUTBOX_BREAKER_OPEN_MS=30000
# OUTBOX_BREAKER_SUCCESS_THRESHOLD=2
#
# Circuit breaker on HTTP sync clients (identity / reward / notification).
# Shared per dependency name (http->identity, http->reward, http->notification).
# HTTP_BREAKER_FAILURE_THRESHOLD=5
# HTTP_BREAKER_OPEN_MS=30000
# HTTP_BREAKER_SUCCESS_THRESHOLD=2

# Internal API key protecting incident-service's own internal-only routes
# (e.g. POST /api/v1/organizations, called by the application approval saga).
# INTERNAL_INCIDENT_API_KEY=must-match-callers

# Cloudinary credentials used to sign uploads of organization application documents
# (private delivery type "authenticated"; logos/banners keep using the public preset).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Rate limits on the public organization-application endpoints.
# OTP_RATE_WINDOW_MS=3600000
# OTP_RATE_MAX_PER_EMAIL=3      (also caps the DB-side counter in requestOtp)
# OTP_RATE_MAX_PER_IP=10
# APPLICATION_RATE_WINDOW_MS=3600000
# APPLICATION_RATE_MAX_PER_IP=60
#
# Local escape hatch: turns every limit above off, so you can re-request a code as often as
# you like. It is IGNORED when NODE_ENV=production — these limits are the only thing stopping
# this service from being used to mail-bomb a stranger, so one stray env var must not be able
# to switch them off in a deployment. Raise the numbers above instead of using this if you
# want a higher-but-still-finite budget.
# APPLICATION_RATE_LIMIT_DISABLED=true

# Organization application pipeline: OTP / submission-token / tracking-link lifetimes.
# APPLICATION_OTP_TTL_MS=600000
# APPLICATION_OTP_MAX_ATTEMPTS=5
# APPLICATION_SUBMISSION_TOKEN_TTL_MS=1800000
# APPLICATION_TRACKING_TOKEN_TTL_MS=15552000000
