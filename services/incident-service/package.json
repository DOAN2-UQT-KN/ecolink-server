{
  "name": "incident-service",
  "version": "1.0.0",
  "description": "Incident service for DA2 application - handles reports, tasks, and volunteer management",
  "main": "dist/index.js",
  "scripts": {
    "build:queue": "npm ci --prefix ../../shared/da2-queue && npm run build --prefix ../../shared/da2-queue",
    "build:constants": "npm ci --prefix ../../shared/da2-constants && npm run build --prefix ../../shared/da2-constants",
    "build:express-swagger": "npm ci --prefix ../../shared/express-swagger && npm run build --prefix ../../shared/express-swagger",
    "prebuild": "npm run build:queue && npm run build:constants && npm run build:express-swagger",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "start:production": "npm run prisma:migrate:deploy && npm run start",
    "start:worker:production": "npm run prisma:migrate:deploy && npm run worker",
    "dev": "nodemon",
    "dev:worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "test": "jest",
    "test:it": "jest --config jest.integration.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "keywords": [
    "incident",
    "report",
    "task",
    "volunteer",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.879.0",
    "@da2/constants": "file:../../shared/da2-constants",
    "@da2/express-swagger": "file:../../shared/express-swagger",
    "@da2/queue": "file:../../shared/da2-queue",
    "@prisma/client": "^6.19.2",
    "axios": "^1.6.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dd-trace": "^5.110.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "ts-json-schema-generator": "^2.4.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.3",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.37",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
