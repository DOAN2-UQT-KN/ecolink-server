// Prisma schema for Incident Service

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), postgis]
}

model Report {
  id            String  @id @default(uuid()) @db.Uuid
  campaignId    String? @map("campaign_id") @db.Uuid
  userId        String? @map("user_id") @db.Uuid
  title         String? @db.VarChar(200)
  titleVi       String? @map("title_vi") @db.VarChar(200)
  titleEn       String? @map("title_en") @db.VarChar(200)
  description   String?
  descriptionVi String? @map("description_vi")
  descriptionEn String? @map("description_en")

  wasteType     String? @map("waste_type") @db.VarChar(100)
  severityLevel Int?    @map("severity_level")

  // PostGIS Geography point stored as raw - we'll use raw queries for spatial operations
  latitude  Float?
  longitude Float?

  /**
   * Human-readable location text (e.g. street / place name from reverse geocoding).
   */
  detailAddress String? @map("detail_address")

  status Int? @default(12)

  /**
   * Admin moderation: only admins can set true (see verify endpoint).
   */
  isVerify     Boolean @default(false) @map("is_verify")
  /**
   * Admin-provided reason when the report is banned; cleared on verify.
   */
  rejectReason String? @map("reject_reason")

  aiVerified Boolean @default(false) @map("ai_verified")

  /**
   * LLM recommendation after image/object analysis.
   */
  aiRecommendation String? @map("ai_recommendation")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  reportMediaFiles ReportMediaFile[]
  reportIssues     ReportIssue[]
  aiAnalysisLogs   AiAnalysisLog[]
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@map("reports")
}

model Campaign {
  id            String    @id @default(uuid()) @db.Uuid
  title         String    @db.VarChar(200)
  titleVi       String?   @map("title_vi") @db.VarChar(200)
  titleEn       String?   @map("title_en") @db.VarChar(200)
  banner        String?   @db.VarChar(2048)
  description   String?
  descriptionVi String?   @map("description_vi")
  descriptionEn String?   @map("description_en")
  status        Int       @default(12)
  /**
   * Admin-provided reason when the campaign is banned; cleared on verify.
   */
  rejectReason  String?   @map("reject_reason")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  detailAddress String?   @map("detail_address") @db.VarChar(255)
  latitude      Float?
  longitude     Float?
  radiusKm      Float?    @map("radius_km")

  /**
   * Level key into reward-service `difficulties` (volunteer cap, green points).
   */
  difficulty Int @default(1)

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  reports                         Report[]
  campaignManagers                CampaignManager[]
  campaignJoiningRequests         CampaignJoiningRequest[]
  campaignAttendanceCheckIns      CampaignAttendanceCheckIn[]
  campaignTasks                   CampaignTask[]
  campaignSubmissions             CampaignSubmission[]
  campaignResults                 CampaignResult[]
  campaignCompletionVerifications CampaignCompletionVerification[]
  sosList                         Sos[]

  @@index([status])
  @@index([createdBy])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("campaigns")
}

model Media {
  id   String @id @default(uuid()) @db.Uuid
  url  String
  type String @db.VarChar(50)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  campaignTaskResultFiles CampaignTaskResultFile[]

  @@index([type])
  @@index([deletedAt])
  @@map("media")
}

model ReportMediaFile {
  id       String  @id @default(uuid()) @db.Uuid
  reportId String? @map("report_id") @db.Uuid

  mediaId String @map("media_id") @db.Uuid

  uploadedBy String? @map("uploaded_by") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  report Report? @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@index([mediaId])
  @@map("report_media_files")
}

model CampaignTask {
  id         String  @id @default(uuid()) @db.Uuid
  campaignId String? @map("campaign_id") @db.Uuid

  title         String? @db.VarChar(200)
  titleVi       String? @map("title_vi") @db.VarChar(200)
  titleEn       String? @map("title_en") @db.VarChar(200)
  description   String?
  descriptionVi String? @map("description_vi")
  descriptionEn String? @map("description_en")
  priority      Int     @default(2)

  status Int @default(12)

  scheduledDate DateTime? @map("scheduled_date")
  scheduledTime String?   @map("scheduled_time") @db.VarChar(50)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  campaign                Campaign?                @relation(fields: [campaignId], references: [id])
  campaignTaskAssignments CampaignTaskAssignment[]
  campaignTaskResult      CampaignTaskResult?

  @@index([campaignId])
  @@index([status])
  @@map("campaign_tasks")
}

/**
 * Optional evidence / notes submitted for a campaign task (one row per task).
 */
model CampaignTaskResult {
  id             String  @id @default(uuid()) @db.Uuid
  campaignTaskId String  @unique @map("campaign_task_id") @db.Uuid
  description    String?
  descriptionVi  String? @map("description_vi")
  descriptionEn  String? @map("description_en")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaignTask CampaignTask             @relation(fields: [campaignTaskId], references: [id], onDelete: Cascade)
  files        CampaignTaskResultFile[]

  @@map("campaign_task_results")
}

model CampaignTaskResultFile {
  id                   String @id @default(uuid()) @db.Uuid
  campaignTaskResultId String @map("campaign_task_result_id") @db.Uuid
  mediaId              String @map("media_id") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaignTaskResult CampaignTaskResult @relation(fields: [campaignTaskResultId], references: [id], onDelete: Cascade)
  media              Media              @relation(fields: [mediaId], references: [id])

  @@index([campaignTaskResultId])
  @@index([mediaId])
  @@map("campaign_task_result_files")
}

model CampaignTaskAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  campaignTaskId String? @map("campaign_task_id") @db.Uuid
  volunteerId    String? @map("volunteer_id") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  campaignTask CampaignTask? @relation(fields: [campaignTaskId], references: [id])

  @@index([campaignTaskId])
  @@index([volunteerId])
  @@map("campaign_task_assignments")
}

model CampaignJoiningRequest {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @map("campaign_id") @db.Uuid
  volunteerId String? @map("volunteer_id") @db.Uuid

  status Int @default(12)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([volunteerId])
  @@index([status])
  @@map("campaign_joining_requests")
}

/// In-person check-in for approved volunteers (QR flow). Used for completion green points eligibility.
model CampaignAttendanceCheckIn {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  checkedInAt DateTime @default(now()) @map("checked_in_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@map("campaign_attendance_check_ins")
}

// A submission is created by a campaign manager to document cleanup work.
// One campaign can have multiple submissions over time.
model CampaignSubmission {
  id          String @id @default(uuid()) @db.Uuid
  campaignId  String @map("campaign_id") @db.Uuid
  submittedBy String @map("submitted_by") @db.Uuid // manager who submitted

  title         String? @db.VarChar(200)
  titleVi       String? @map("title_vi") @db.VarChar(200)
  titleEn       String? @map("title_en") @db.VarChar(200)
  description   String?
  descriptionVi String? @map("description_vi")
  descriptionEn String? @map("description_en")

  status Int @default(12) // PENDING → in review / approved / rejected after process

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  campaign        Campaign         @relation(fields: [campaignId], references: [id])
  campaignResults CampaignResult[]

  @@index([campaignId])
  @@index([submittedBy])
  @@index([status])
  @@index([deletedAt])
  @@map("campaign_submissions")
}

// A result is cleanup evidence for a campaign. While draft (no submission yet), campaignSubmissionId is null.
model CampaignResult {
  id                   String  @id @default(uuid()) @db.Uuid
  campaignId           String  @map("campaign_id") @db.Uuid
  campaignSubmissionId String? @map("campaign_submission_id") @db.Uuid

  title         String  @db.VarChar(200)
  titleVi       String? @map("title_vi") @db.VarChar(200)
  titleEn       String? @map("title_en") @db.VarChar(200)
  description   String?
  descriptionVi String? @map("description_vi")
  descriptionEn String? @map("description_en")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  campaign            Campaign             @relation(fields: [campaignId], references: [id])
  campaignSubmission  CampaignSubmission?  @relation(fields: [campaignSubmissionId], references: [id])
  campaignResultFiles CampaignResultFile[]

  @@index([campaignId])
  @@index([campaignSubmissionId])
  @@index([deletedAt])
  @@map("campaign_results")
}

// Media files attached to a campaign result.
model CampaignResultFile {
  id               String @id @default(uuid()) @db.Uuid
  campaignResultId String @map("campaign_result_id") @db.Uuid
  mediaId          String @map("media_id") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  campaignResult CampaignResult @relation(fields: [campaignResultId], references: [id])

  @@index([campaignResultId])
  @@index([mediaId])
  @@map("campaign_result_files")
}

model ReportIssue {
  id         String  @id @default(uuid()) @db.Uuid
  reportId   String? @map("report_id") @db.Uuid
  reporterId String? @map("reporter_id") @db.Uuid

  issueType     String? @map("issue_type") @db.VarChar(50)
  description   String?
  descriptionVi String? @map("description_vi")
  descriptionEn String? @map("description_en")
  mediaFileUrl  String? @map("media_file_url")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  report Report? @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@index([reporterId])
  @@map("report_issues")
}

model CampaignManager {
  campaignId String @map("campaign_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@id([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@map("campaign_managers")
}

model AiAnalysisLog {
  id       String @id @default(uuid()) @db.Uuid
  reportId String @map("report_id") @db.Uuid

  reportMediaFileId String? @map("report_media_file_id") @db.Uuid
  mediaId           String? @map("media_id") @db.Uuid
  detections        Int?

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  report      Report   @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@index([reportMediaFileId])
  @@index([mediaId])
  @@map("ai_analysis_logs")
}

model BackgroundJob {
  id String @id @default(uuid()) @db.Uuid

  jobType String @map("job_type") @db.VarChar(100)
  payload Json

  status      Int      @default(12)
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  runAfter    DateTime @default(now()) @map("run_after")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([jobType, status, runAfter])
  @@index([status, runAfter])
  @@map("background_jobs")
}

/// Transactional outbox: rows are written in the SAME transaction as the
/// business change, then a relay delivers them to other services (at-least-once).
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid

  aggregateType String @map("aggregate_type") @db.VarChar(50)
  aggregateId   String @map("aggregate_id") @db.Uuid

  /// Reuses the downstream (reward) job-type string, e.g. REPORT_COMPLETION_GREEN_POINTS.
  eventType String @map("event_type") @db.VarChar(100)
  payload   Json

  /// Deterministic key so re-emits / reconciliation never duplicate a row.
  dedupKey String @unique @map("dedup_key")

  status      Int      @default(12)
  attempts    Int      @default(0)
  maxAttempts Int      @default(10) @map("max_attempts")
  runAfter    DateTime @default(now()) @map("run_after")
  lastError   String?  @map("last_error")

  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@map("outbox_events")
}

model Vote {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @map("user_id") @db.Uuid
  /**
   * 1 = upvote, -1 = downvote, 0 = cancelled / neutral
   */
  value        Int
  resourceType String @map("resource_type") @db.VarChar(32)
  resourceId   String @map("resource_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@index([userId])
  @@map("votes")
}

/// Community verification after campaign completion (clean / not clean). Separate from votes.
model CampaignCompletionVerification {
  id         String @id @default(uuid()) @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  /**
   * 1 = clean, -1 = not clean, 0 = cleared
   */
  value      Int

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([userId, campaignId])
  @@index([campaignId])
  @@map("campaign_completion_verifications")
}

model SavedResource {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @map("user_id") @db.Uuid
  resourceId   String @map("resource_id") @db.Uuid
  resourceType String @map("resource_type") @db.VarChar(32)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@index([userId])
  @@map("saved_resources")
}

/**
 * A group with exactly one owner (`ownerId`). Other users join via `OrganizationJoiningRequest`.
 */
model Organization {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @db.VarChar(200)
  /**
   * URL-stable identifier generated from `name` on create; not changed on rename.
   */
  slug          String  @unique @db.VarChar(220)
  description   String?
  descriptionVi String? @map("description_vi")
  descriptionEn String? @map("description_en")

  /**
   * Public logo image URL (required on create).
   */
  logoUrl       String  @map("logo_url") @db.VarChar(2048)
  /**
   * Optional public background / banner image URL.
   */
  backgroundUrl String? @map("background_url") @db.VarChar(2048)
  contactEmail  String? @map("contact_email") @db.VarChar(320)

  /**
   * Public postal address, shown on the organization page.
   */
  address String? @db.VarChar(500)

  /**
   * Point the applicant picked on the map; null when they skipped that step.
   */
  latitude  Float?
  longitude Float?

  /**
   * Inherited from the OTP the applicant passed before submitting; no second verification.
   */
  isEmailVerified Boolean @default(false) @map("is_email_verified")
  /**
   * Lifecycle. Rows only exist once an admin approved the application, so the default is
   * `GlobalStatus._STATUS_ACTIVE`; admins move it to `INACTIVE` to ban.
   */
  status          Int     @default(1)
  /**
   * Admin-provided reason when the organization is banned; cleared on verify unless sent.
   */
  rejectReason    String? @map("reject_reason")

  /**
   * `OrgType` — kind of legal entity, declared by the applicant and confirmed by an admin.
   */
  orgType               String?   @map("org_type") @db.VarChar(32)
  /**
   * `KycStatus` — verdict on the legal paperwork.
   */
  kycStatus             String    @default("NOT_SUBMITTED") @map("kyc_status") @db.VarChar(20)
  /**
   * `TrustTier` — Blue Tick privilege level; independent of `kycStatus`.
   */
  trustTier             String    @default("NONE") @map("trust_tier") @db.VarChar(10)
  /**
   * Set while a violation is being handled: the tick stops granting privileges.
   */
  tickSuspended         Boolean   @default(false) @map("tick_suspended")
  /**
   * Lane A only: an admin confirmed the contact email uses the entity's official domain.
   */
  domainVerified        Boolean   @default(false) @map("domain_verified")
  verifiedAt            DateTime? @map("verified_at")
  verifiedBy            String?   @map("verified_by") @db.Uuid
  /**
   * Lane B tick expires and must be re-assessed; NULL for lane A.
   */
  verificationExpiresAt DateTime? @map("verification_expires_at")
  tickRevokedReason     String?   @map("tick_revoked_reason")

  /**
   * 0–100, recomputed on every profile update; an input of the Blue Tick rules.
   */
  profileCompleteness     Int @default(0) @map("profile_completeness")
  /**
   * Denormalized counters feeding the (later) eligibility rule engine.
   */
  successfulCampaignCount Int @default(0) @map("successful_campaign_count")
  violationCount          Int @default(0) @map("violation_count")

  /**
   * NULL = use `DEFAULT_LEGAL_REP_ORG_LIMIT`; an admin may raise it for one organization.
   */
  legalRepLimitOverride Int? @map("legal_rep_limit_override")

  /**
   * The dedicated `accountType = ORG` login. NULLABLE on purpose: provisioning writes the
   * organization first and fills this in a second step, so queries must tolerate NULL.
   */
  ownerId String? @map("owner_id") @db.Uuid

  /**
   * Application this organization was created from; kept for traceability.
   */
  applicationId String? @unique @map("application_id") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members      OrganizationMember[]
  joinRequests OrganizationJoiningRequest[]
  campaigns    Campaign[]
  channels     OrganizationChannel[]
  violations   OrganizationViolation[]
  application  OrganizationApplication?     @relation(fields: [applicationId], references: [id])

  @@index([ownerId])
  @@index([deletedAt])
  @@index([trustTier, status])
  @@index([kycStatus, verificationExpiresAt])
  @@map("organizations")
}

/**
 * Approved members (owner is not duplicated here; use `Organization.ownerId`).
 */
model OrganizationMember {
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

/// Emergency request created under a specific campaign.
model Sos {
  id         Int    @id @default(autoincrement())
  campaignId String @map("campaign_id") @db.Uuid

  content       String
  contentVi     String? @map("content_vi")
  contentEn     String? @map("content_en")
  phone         String  @db.VarChar(20)
  address       String  @db.VarChar(500)
  detailAddress String? @map("detail_address") @db.VarChar(255)

  latitude  Float
  longitude Float

  status Int @default(12)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([status])
  @@index([deletedAt])
  @@map("sos")
}

model OrganizationJoiningRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  requesterId    String @map("requester_id") @db.Uuid

  status Int @default(12)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([requesterId])
  @@index([status])
  @@map("organization_joining_requests")
}

/**
 * A request to found an organization. This is a first-class entity, NOT an organization in a
 * draft state: `organizations` only ever holds approved rows, so rejected and abandoned
 * submissions never pollute it.
 */
model OrganizationApplication {
  id   String @id @default(uuid()) @db.Uuid
  /**
   * Short human-readable code the applicant uses to look the submission up.
   */
  code String @unique @db.VarChar(16)

  /**
   * `OrgType` declared by the applicant.
   */
  orgType               String  @map("org_type") @db.VarChar(32)
  /**
   * `ApplicationStatus`.
   */
  status                String  @default("SUBMITTED") @db.VarChar(20)
  /**
   * `ApplicationLane`. NULL while the application is open — the system never guesses the lane
   * from the email domain; only an admin sets it when deciding.
   */
  lane                  String? @db.VarChar(1)
  /**
   * Admins may waive the document requirement (typically lane A); the reason is mandatory.
   */
  documentsWaived       Boolean @default(false) @map("documents_waived")
  documentsWaivedReason String? @map("documents_waived_reason")

  /**
   * Public-facing profile proposed for the organization: name, contactEmail, logoUrl, …
   */
  profile  Json
  /**
   * Proposed public channels: `[{ type, url, isPrimary }]`.
   */
  channels Json @default("[]")

  /**
   * Normalized copy of `profile.contactEmail`, used for the one-open-application rule.
   */
  contactEmail String @map("contact_email") @db.VarChar(320)

  /**
   * Legal representative — review data, never displayed publicly and never copied onto the
   * organization. The raw ID number is NOT stored: only a hash (for the per-person org cap)
   * and the last 4 characters (to confirm identity during a dispute).
   */
  legalRepName     String? @map("legal_rep_name") @db.VarChar(200)
  legalRepPhone    String? @map("legal_rep_phone") @db.VarChar(32)
  legalRepEmail    String? @map("legal_rep_email") @db.VarChar(320)
  legalRepPosition String? @map("legal_rep_position") @db.VarChar(200)
  legalRepIdType   String? @map("legal_rep_id_type") @db.VarChar(20)
  legalRepIdHash   String? @map("legal_rep_id_hash") @db.VarChar(64)
  legalRepIdLast4  String? @map("legal_rep_id_last4") @db.VarChar(4)

  /**
   * NULL when submitted anonymously (the common case — the form needs no login).
   */
  submittedByUserId String?   @map("submitted_by_user_id") @db.Uuid
  /**
   * When the OTP on `contactEmail` passed; inherited by `organizations.isEmailVerified`.
   */
  emailVerifiedAt   DateTime? @map("email_verified_at")
  /**
   * Timestamp of the personal-data consent checkbox.
   */
  consentedAt       DateTime? @map("consented_at")

  /**
   * Set by `claim` so two admins never review the same submission.
   */
  reviewerId   String?   @map("reviewer_id") @db.Uuid
  claimedAt    DateTime? @map("claimed_at")
  reviewedAt   DateTime? @map("reviewed_at")
  /**
   * Message sent with `request-info`, or the rejection reason.
   */
  reviewNote   String?   @map("review_note")
  rejectReason String?   @map("reject_reason")

  /**
   * Filled once the approval saga created the organization.
   */
  organizationId       String?   @map("organization_id") @db.Uuid
  /**
   * NULL while the ORG login has not been created yet — the relay retries until it is.
   */
  accountProvisionedAt DateTime? @map("account_provisioned_at")
  /**
   * Set by the retention job once documents and `legalRep*` have been erased.
   */
  purgedAt             DateTime? @map("purged_at")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  documents    OrganizationApplicationDocument[]
  events       OrganizationApplicationEvent[]
  organization Organization?

  @@index([status])
  @@index([contactEmail])
  @@index([legalRepIdHash])
  @@index([reviewerId])
  @@index([deletedAt])
  @@map("organization_applications")
}

/**
 * A legal document attached to an application. The file itself lives in private storage.
 */
model OrganizationApplicationDocument {
  id              String  @id @default(uuid()) @db.Uuid
  /**
   * NULL between the presign call and the submit call: the form uploads paperwork before the
   * application row exists. `submissionEmail` scopes an orphan to the mailbox that uploaded it.
   */
  applicationId   String? @map("application_id") @db.Uuid
  /**
   * Verified mailbox of the uploader, copied from the submission token.
   */
  submissionEmail String  @map("submission_email") @db.VarChar(320)

  /**
   * `ApplicationDocType`.
   */
  docType    String  @map("doc_type") @db.VarChar(32)
  /**
   * Opaque handle from `DocumentStorage`; never a publicly reachable URL.
   */
  storageKey String  @map("storage_key") @db.VarChar(512)
  /**
   * Normalized extension (`pdf` | `jpg` | `png`), needed to read the file back.
   */
  format     String  @db.VarChar(8)
  mimeType   String  @map("mime_type") @db.VarChar(100)
  sizeBytes  Int     @map("size_bytes")
  fileName   String? @map("file_name") @db.VarChar(255)

  /**
   * Set by the retention job after the file has been deleted from storage.
   */
  purgedAt DateTime? @map("purged_at")

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  application OrganizationApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([submissionEmail])
  @@index([deletedAt])
  @@map("organization_application_documents")
}

/**
 * Audit trail. Kept after the purge job erases the documents, because it is the only
 * remaining evidence that a review actually happened and who waived what.
 */
model OrganizationApplicationEvent {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  /**
   * `ApplicationEventType`.
   */
  eventType String  @map("event_type") @db.VarChar(40)
  /**
   * NULL for actions taken by the anonymous applicant.
   */
  actorId   String? @map("actor_id") @db.Uuid
  payload   Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  application OrganizationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("organization_application_events")
}

/**
 * One-time codes and submission tokens for the anonymous application form. These cannot live
 * in identity-service's `auth_tokens` because that table is keyed by a user, and an applicant
 * has no account yet.
 */
model OrganizationApplicationOtp {
  id    String @id @default(uuid()) @db.Uuid
  email String @db.VarChar(320)

  /**
   * `OTP` (6-digit code) or `SUBMISSION` (token handed out after the code was accepted).
   */
  purpose  String @db.VarChar(16)
  /**
   * sha256 of the code / token — never the value itself.
   */
  codeHash String @map("code_hash") @db.VarChar(64)

  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  /**
   * Set on first successful use; both purposes are single-use.
   */
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email, purpose])
  @@index([codeHash])
  @@index([expiresAt])
  @@map("organization_application_otps")
}

/**
 * Public contact channel of an approved organization (fanpage / website / Zalo OA).
 */
model OrganizationChannel {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /**
   * `OrganizationChannelType`.
   */
  type      String  @db.VarChar(32)
  url       String  @db.VarChar(2048)
  isPrimary Boolean @default(false) @map("is_primary")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([deletedAt])
  @@map("organization_channels")
}

/**
 * Recorded misconduct. The table exists so the Blue Tick revocation rules have somewhere to
 * read from; nothing writes to it yet (post-moderation lands in a later phase).
 */
model OrganizationViolation {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  campaignId     String? @map("campaign_id") @db.Uuid

  /**
   * `ViolationSeverity`.
   */
  severity String @db.VarChar(10)
  reason   String

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([deletedAt])
  @@map("organization_violations")
}
